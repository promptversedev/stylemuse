# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-only, never expose to the client.
# Used by API routes to bypass RLS for the public embed/widget endpoint.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudflare R2 (image storage) ───────────────────────────────────────────
# R2 → Manage R2 API Tokens → create an API token with Object Read & Write
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=swap-model-bg-images
# Public hostname the bucket is served from — either the R2.dev dev URL
# (<bucket-id>.r2.dev) or a custom domain you've connected to the bucket.
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=pub-xxxxxxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── App ──────────────────────────────────────────────────────────────────
# Used to build absolute callback / embed URLs. In prod this is your
# deployed Cloudflare Workers/Pages URL or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google OAuth ─────────────────────────────────────────────────────────
# Google sign-in is configured on the SUPABASE side, not here:
# Supabase Dashboard → Authentication → Providers → Google
#   - Client ID / Client Secret from Google Cloud Console (OAuth 2.0 Client)
#   - Authorized redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# No Google secrets are needed in this app's env — Supabase handles the OAuth
# exchange and redirects back to NEXT_PUBLIC_SITE_URL/auth/callback.

# Origins allowed to receive a public_token via ?return= (Vastralook Studio)
NEXT_PUBLIC_STUDIO_ORIGINS=http://localhost:3002

# Direct Postgres connection, for `npm run db:migrate` only.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the SESSION pooler (port 5432); DDL and advisory locks need session mode.
# The SUPABASE_* keys above cannot run DDL - REST exposes tables and RPCs, not SQL.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"
