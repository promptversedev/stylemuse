{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stylemuse",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No r2_buckets binding here on purpose: the app only ever loads images
  // via the R2 bucket's public HTTPS URL (NEXT_PUBLIC_R2_PUBLIC_URL below),
  // never through a Worker binding — and the bucket lives in a different
  // Cloudflare account than this Worker deploys to.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ocevxoifcfrdchcmauku.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9jZXZ4b2lmY2ZyZGNoY21hdWt1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwODg5NTIsImV4cCI6MjEwNTY2NDk1Mn0.o54IRkpQaHAWlUcS_ebTvM89s0-aGFMJ4T3H9UBeJsA",
    "NEXT_PUBLIC_R2_PUBLIC_URL": "https://pub-9937a81856e4495284603d66becb533d.r2.dev",
    "NEXT_PUBLIC_R2_PUBLIC_HOSTNAME": "pub-9937a81856e4495284603d66becb533d.r2.dev",
    "NEXT_PUBLIC_SITE_URL": "https://stylemuse.gemini-logo-remover.workers.dev",
    // Origins allowed to receive a public_token via ?return=. Without an
    // entry here the "Send to Studio" hand-back does not appear.
    // Public half of the Google OAuth client. The secret is NOT here —
    // set it with `wrangler secret put GOOGLE_CLIENT_SECRET`.
    "GOOGLE_CLIENT_ID": "1087184416394-921t9i5q15niv7s3m4kf19dc17lmapul.apps.googleusercontent.com",
    "NEXT_PUBLIC_STUDIO_ORIGINS": "https://vastralook.vercel.app,http://localhost:3002"
  },
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, R2 access keys, etc.) are NOT set here.
  // Set them with `wrangler secret put <NAME>` — see .env.example.
  "observability": {
    "enabled": true
  }
}
